views {

  global style contours

  view platform--recommendation-serving-api--components of platform.serving {
    title 'Платформа рекомендаций / Recommendation Serving API / Диаграмма компонентов'
    description """
      ### 1. Описание

      Диаграмма компонентов контейнера Recommendation Serving API (C3) и
      соседей, с которыми он обменивается напрямую.

      Здесь видно, что именно кэшируется: **набор кандидатов сегмента**,
      а не итоговая выдача. Она собирается на каждом запросе, поэтому двое
      покупателей одного сегмента получают разные `items` при одинаковых
      `candidate_strategy` и `set_version`. Живого вызова LLM в обработке
      запроса нет: тексты подборок сгенерированы заранее.

      ### 2. Участники

      | № | Компонент | Ответственность |
      |---|---|---|
      | 1 | Recommendation Controller | Принимает запрос, валидирует параметры и следит за бюджетом времени |
      | 2 | Recommendation Orchestrator | Задаёт порядок шагов ответа и собирает итоговую выдачу |
      | 3 | Identity Resolver | Определяет `none`, `session` или `identified` по псевдонимному профилю; при недоступности профиля возвращает `none` |
      | 4 | Segment Resolver | Для `session` и `identified` использует профильный сегмент, для `none` — `seg-anon` |
      | 5 | Cache Client | Читает наборы и тексты по ключу «товар плюс сегмент плюс версия» |
      | 6 | Exclusion Filter | Всегда применяет глобальные стоп-листы; онлайн-сигналы — для `session` и `identified`, офлайн-покупки — только для `identified` |
      | 7 | Ranking Engine | Ранжирует короткий список по наличию и правилам категории |
      | 8 | Description Provider | Отдаёт текст при совпадении версии набора |

      | № | Соседний контейнер | Взаимодействие |
      |---|---|---|
      | 1 | Recommendation Backend | Вызывает сервис по контракту `api/recommendation-serving-api/openapi.yaml` |
      | 2 | Recommendations Cache | Хранит наборы кандидатов и предгенерированные тексты |
      | 3 | SQL DB | Хранит сегменты, исключения, остатки и правила категорий |

      **Легенда**

      | | |
      |---|---|
      | 🟦 | Компоненты контейнера и хранилища, к которым он обращается |
      | 🟩 | Recommendation Backend — вызывающий с критического пути ответа |

      ### 3. Сценарии

      1. **Запрос рекомендации пользователем** — участвуют все восемь компонентов.
      """
    include *
    include platform.backend, platform.cache, platform.sqldb
  }

  dynamic view platform--request-recommendation--dynamic {
    variant sequence
    title 'Платформа рекомендаций / Динамическая диаграмма получения рекомендаций пользователем'
    description """
      ### 1. Описание

      Основной сценарий задания — «Пользователь запрашивает рекомендацию».
      Отрисован как диаграмма последовательности.

      Вызова LLM в сценарии нет: тексты сгенерированы заранее. Проверка версии
      текста против версии итогового набора закрывает рассогласование, при
      котором описание ссылалось бы на товар, выброшенный фильтром исключений.

      Каждый шаг снабжён развёрнутым описанием: оно видно в интерактивном
      walk-through (`likec4 start`), на статическом экспорте остаются короткие
      подписи с технологией.

      ### 2. Участники

      | № | Участник | Ответственность в сценарии |
      |---|---|---|
      | 1 | Покупатель | Открывает карточку товара и видит блок рекомендаций |
      | 2 | Сайт TechnoMart | Даёт слот в шаблоне карточки и заранее поставляет резервный rule-based блок в кэш платформы |
      | 3 | Recommendation Widget | Отображает блок в карточке товара |
      | 4 | Recommendation Backend | Псевдонимизирует пользователя, стабильно назначает рукав A/B-пилота, при отказе читает резервный блок из кэша |
      | 5 | Компоненты Serving API | Собирают ответ из набора кандидатов и персонального слоя |
      | 6 | Recommendations Cache, SQL DB | Источники набора, сегмента, исключений и остатков |

      ### 3. Ветвления и деградации

      | Блок | Условие | Что происходит |
      |---|---|---|
      | `alt` по рукаву | `variant = control` | Serving API не вызывается: отдаётся существующий rule-based блок сайта из кэша |
      | `alt` по рукаву | `variant = treatment` | AI-подборка Serving API; назначение стабильно по хэшу сессии |
      | `alt` по identity | `personalization_level = identified` | Разрешены онлайн-сигналы и исключение подтверждённо связанных офлайн-покупок |
      | `alt` по identity | `personalization_level = session` | Разрешены только онлайн-сигналы сессии; офлайн-покупки не применяются |
      | `alt` по identity | `personalization_level = none` | Используется `seg-anon`; персональные исключения не применяются |
      | `else` по identity | Профиль отсутствует или недоступен | Запрос безопасно продолжается как `none`, без 500 или 503 |
      | `alt` по кэшу | Набор найден | `candidate_strategy: segment_cf`, персональная сборка поверх сегментного набора |
      | `alt` по кэшу | Набора нет | `candidate_strategy: popular_fallback`, отдаётся предрассчитанное популярное |
      | `alt` по тексту | Версия совпала | Применяется предгенерированное описание |
      | `alt` по тексту | Набор изменился | Подставляется статический шаблон без ссылок на товары |
      | `catch` | Таймаут или 503 | Backend читает резервный rule-based блок из Recommendations Cache (наполнен фоново с сайта); в аналитике выдача остаётся в treatment (intent-to-treat) |
      """

    customer -> bitrix {
      title 'Открывает карточку товара SKU-100234'
      technology 'HTTPS'
      description 'Обычная навигация по витрине; платформа в этом шаге не участвует'
    }
    bitrix -> platform.widget {
      title 'Встраивает тег виджета, ссылающийся на бандл платформы, в слот шаблона карточки'
      description 'Ядро Bitrix не изменяется: в слот шаблона добавлен HTML-тег; сам бандл браузер загрузит с Backend отдельным запросом'
    }
    platform.widget -> platform.backend {
      title 'GET /api/widget/recommendations'
      technology 'HTTPS'
      description 'Вызов публичной границы платформы; при первом обращении Backend выставит собственную сессионную cookie в Set-Cookie и по её хэшу стабильно назначит рукав эксперимента ab-cross-sell-mvp: повторные заходы покупателя попадают в тот же рукав'
    }

    alt {
      when 'variant = control: существующий baseline сайта' {
        platform.backend -> platform.cache {
          title 'GET rb:SKU-100234:product_card_cross_sell'
          technology 'Redis protocol'
          description 'Control-рукав получает тот же блок «с этим товаром часто покупают», что сайт показывает сегодня: Serving API не вызывается, AI-выдача не участвует — иначе рукава получили бы одинаковый алгоритм и пилот не измерил бы эффект'
        }
        platform.backend <- platform.cache {
          title 'Rule-based подборка, candidate_strategy = rule_based'
          description 'Блок не персонализирован (personalization_level: none), поэтому ключ кэша — «товар плюс слот»; в событиях показа зафиксируется variant = control'
        }
      }
      else 'variant = treatment: AI-подборка' {
        try 'бюджет ответа 200 мс' {
      platform.backend -> platform.serving.controller {
        title 'GET /get_recommendation, X-User-Ref в заголовке'
        technology 'HTTPS'
        description 'Backend преобразует сессионную cookie в псевдонимный X-User-Ref: персональные данные не покидают доверенный контур, ML-контур получает только псевдоним'
      }
      platform.serving.controller -> platform.serving.orchestrator {
        title 'Валидирует параметры и передаёт запрос'
        description 'Внутрипроцессный вызов; контроллер следит за бюджетом ответа 200 мс'
      }
      platform.serving.orchestrator -> platform.serving.identity {
        title 'Определяет personalization_level по X-User-Ref'
        description 'Внутрипроцессный вызов; сырой client_id из 1С отсутствует в запросе'
      }
      platform.serving.identity -> platform.sqldb {
        title 'Читает псевдонимный профиль'
        technology 'SQL'
        description 'Профиль содержит только разрешённый уровень связи и производные данные'
      }
      alt {
        when 'профиль найден' {
          platform.serving.orchestrator <- platform.serving.identity {
            title 'personalization_level = session либо identified'
            description 'identified возможен только при подтверждённой на Discovery связи сайта с клиентом 1С'
          }
        }
        else 'профиль отсутствует или недоступен' {
          platform.serving.orchestrator <- platform.serving.identity {
            title 'personalization_level = none'
            description 'Запрос продолжается с seg-anon, без 500 или 503'
          }
        }
      }
      platform.serving.orchestrator -> platform.serving.segments {
        title 'Запрашивает сегмент покупателя'
        description 'Внутрипроцессный вызов; при personalization_level = none подставляется seg-anon'
      }
      platform.serving.segments -> platform.sqldb {
        title 'Читает витрину сегментов по X-User-Ref'
        technology 'SQL'
        description 'Чтение по ключу из PostgreSQL; витрину сегментов публикует офлайн-пайплайн'
      }
      platform.serving.orchestrator <- platform.serving.segments {
        title 'seg-7 либо seg-anon'
        description 'При personalization_level = none используется seg-anon без персональных исключений'
      }
      platform.serving.orchestrator -> platform.serving.cacheClient {
        title 'Запрашивает набор кандидатов сегмента'
        description 'Внутрипроцессный вызов; кэшируется набор кандидатов сегмента, а не итоговая выдача, поэтому персональный слой применяется на каждом запросе'
      }

      alt {
        when 'набор есть: candidate_strategy = segment_cf' {
          platform.serving.cacheClient -> platform.cache {
            title 'GET cand:SKU-100234:seg-7'
            technology 'Redis protocol'
            description 'Ключ — «товар плюс сегмент плюс версия»; версия в ключе не даёт тексту и набору рассогласоваться'
          }
          platform.serving.orchestrator <- platform.serving.cacheClient {
            title 'Кандидаты сегмента и версия set_version'
            description 'Двое покупателей одного сегмента получат один набор кандидатов, но разную итоговую выдачу после исключений и ранжирования'
          }
        }
        else 'набора нет: candidate_strategy = popular_fallback' {
          platform.serving.cacheClient -> platform.cache {
            title 'GET popular:category-42'
            technology 'Redis protocol'
            description 'Промах кэша закрывается предрассчитанным популярным набором категории, а не живым расчётом'
          }
          platform.serving.orchestrator <- platform.serving.cacheClient {
            title 'Предрассчитанное популярное в категории'
            description 'Выдача остаётся в бюджете 200 мс даже на холодном ключе'
          }
        }
      }

      platform.serving.orchestrator -> platform.serving.exclusions {
        title 'Применяет глобальные стоп-листы и персональные исключения по уровню'
        description 'Внутрипроцессный вызов; глобальные стоп-листы применяются для всех уровней'
      }
      alt {
        when 'personalization_level = identified' {
          platform.serving.exclusions -> platform.sqldb {
            title 'Читает онлайн-сигналы и офлайн-покупки'
            technology 'SQL'
            description 'Офлайн-покупки доступны только для подтверждённо связанного псевдонимного профиля'
          }
        }
        else 'personalization_level = session' {
          platform.serving.exclusions -> platform.sqldb {
            title 'Читает только онлайн-сигналы сессии'
            technology 'SQL'
            description 'Связи с client_id из 1С нет; офлайн-покупки не применяются'
          }
        }
        else 'personalization_level = none' {
          platform.serving.orchestrator <- platform.serving.exclusions {
            title 'Только глобальные стоп-листы'
            description 'Персональные исключения не применяются'
          }
        }
      }
      platform.serving.orchestrator -> platform.serving.ranking {
        title 'Ранжирует по наличию и правилам категории'
        description 'Внутрипроцессный вызов; короткий список после исключений упорядочивается по остаткам и бизнес-правилам'
      }
      platform.serving.ranking -> platform.sqldb {
        title 'Читает остатки и бизнес-правила'
        technology 'SQL'
        description 'Чтение по ключу из PostgreSQL; товар без остатка понижается или исключается из выдачи'
      }
      platform.serving.orchestrator -> platform.serving.descriptions {
        title 'Запрашивает текст для итогового набора'
        description 'Внутрипроцессный вызов; живого вызова LLM нет — тексты предгенерированы офлайн и лежат в кэше под версией набора'
      }
      platform.serving.descriptions -> platform.serving.cacheClient {
        title 'Читает текст по версии набора'
        description 'Внутрипроцессный вызов; текст применяется, только если его версия совпала с версией итогового набора после исключений и ранжирования'
      }

      alt {
        when 'версия текста совпала с версией итогового набора' {
          platform.serving.orchestrator <- platform.serving.descriptions {
            title 'Предгенерированный текст'
            description 'Текст гарантированно ссылается только на товары, оставшиеся в выдаче'
          }
        }
        else 'набор изменился после исключений и ранжирования' {
          platform.serving.orchestrator <- platform.serving.descriptions {
            title 'Статический шаблон без ссылок на товары'
            description 'Рассогласование версий закрывается шаблоном: описание не упоминает конкретные товары и не может соврать'
          }
        }
      }

      platform.serving.controller <- platform.serving.orchestrator {
        title 'Собранный ответ'
        description 'Итоговая выдача: items, candidate_strategy, personalization_level, set_version и текст объяснения'
      }
      platform.backend <- platform.serving.controller {
        title '200 OK'
        technology 'HTTPS'
        description 'Ответ в бюджете 200 мс: на критическом пути только чтения по ключу из кэша и SQL DB'
      }
    }
    catch 'таймаут 200 мс или 503' {
      platform.backend -> platform.cache {
        title 'GET rb:SKU-100234:product_card_cross_sell'
        technology 'Redis protocol'
        description 'Резервный rule-based блок синхронизирован с сайтом заранее: чтение из кэша занимает единицы миллисекунд, и бюджет ответа выдерживается даже в деградации'
      }
      platform.backend <- platform.cache {
        title 'Подборка «с этим товаром часто покупают», candidate_strategy = rule_based'
        description 'Блок не персонализирован (personalization_level: none), поэтому ключ кэша — «товар плюс слот». Ответ тот же, что в control, но variant остаётся treatment: деградировавшие выдачи анализируются в своём рукаве (intent-to-treat), иначе отказы Serving смешали бы рукава'
      }
    }
      }
    }

    platform.widget <- platform.backend {
      title '200 OK, JSON'
      technology 'HTTPS'
      description 'Деградация прозрачна для виджета: и штатная, и резервная выдача приходят кодом 200, различие — в маркере candidate_strategy'
    }
    customer <- platform.widget {
      title 'Видит блок рекомендаций с объяснением'
      description 'Пустого места на странице нет ни в штатном режиме, ни при отказе Serving API'
    }
    platform.widget -> platform.events {
      title 'Отправляет событие показа, request_id подборки'
      technology 'HTTPS, sendBeacon'
      description 'Асинхронно, после ответа покупателю: событие не входит в бюджет 200 мс. По request_id показ связывается с выдачей, по experiment_id и variant — с рукавом A/B-пилота; клик отправляется так же при переходе'
    }
  }

}
